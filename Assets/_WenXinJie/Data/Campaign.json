  "nodes": [
    {
      "id": "c01.gate",
      "chapter": "卷一 · 雨叩山门",
      "location": "青云山 · 山门",
      "speaker": "旁白",
      "text": "山雨入衣，登仙帖上的朱印却仍像新鲜的血。\n三十日后，你的名字将被刻上登仙台。今日山门前，迎接你的没有仙鹤与钟乐，只有一条被雨水洗得发白的长阶。",
      "background": "gate",
      "portrait": "",
      "rain": true,
      "next": "c01.arrival",
      "effects": [],
      "choices": []
    },
    {
      "id": "c01.arrival",
      "chapter": "卷一 · 雨叩山门",
      "location": "青云山 · 山门",
      "speaker": "旁白",
      "text": "守门弟子验过帖子，目光在你的生辰上停了一瞬，随后匆匆避开。\n檐下站着一名灰青衣衫的女子。她替你接过湿透的行囊，却没有说一句恭喜。",
      "background": "gate",
      "portrait": "linYue",
      "rain": true,
      "next": "c01.warning",
      "effects": [],
      "choices": []
    },
    {
      "id": "c01.warning",
      "chapter": "卷一 · 雨叩山门",
      "location": "青云山 · 山门",
      "speaker": "林月",
      "text": "“我叫林月，暂领你入外门。”\n她把你的登仙帖翻到背面。纸背有一道被刀锋刮去的旧名，残留的墨痕与你的生辰恰好重叠。\n“十年前，也有人拿着这张帖子上山。他没有登仙。”",
      "background": "gate",
      "portrait": "linYue",
      "rain": true,
      "next": "c01.response",
      "effects": [],
      "choices": []
    },
    {
      "id": "c01.response",
      "chapter": "卷一 · 雨叩山门",
      "location": "青云山 · 山门",
      "speaker": "林月",
      "text": "石阶上方传来巡钟。林月松开帖子，声音压得更低。\n“日落后，我在松风岭等你。旧名册也会在今夜移交。你只有两个时辰，先弄清什么，由你决定。”",
      "background": "gate",
      "portrait": "linYue",
      "rain": true,
      "effects": [],
      "choices": [
        {
          "id": "ask",
          "text": "追问被刮去的人是谁",
          "target": "c01.response.ask",
          "lockedReason": "",
          "conditions": [],
          "effects": []
        },
        {
          "id": "watch",
          "text": "先收好帖子，记下她的反应",
          "target": "c01.response.watch",
          "lockedReason": "",
          "conditions": [],
          "effects": []
        }
      ]
    },
    {
      "id": "c01.response.ask",
      "chapter": "卷一 · 雨叩山门",
      "location": "青云山 · 山门",
      "speaker": "林月",
      "text": "林月沉默良久，只说那是她的师兄。\n宗门宣称他已飞升天外，可十年来，他留在命灯殿里的灯火从未熄灭。她还想再说，巡山执事的影子已经越过牌楼。",
      "background": "gate",
      "portrait": "linYue",
      "rain": true,
      "next": "c01.hub",
      "effects": [],
      "choices": []
    },
    {
      "id": "c01.response.watch",
      "chapter": "卷一 · 雨叩山门",
      "location": "青云山 · 山门",
      "speaker": "心念",
      "text": "你没有立刻答应。林月指尖有常年握剑留下的薄茧，袖口却沾着新鲜炉灰。\n她像是刚从不该去的地方回来，也像是早已料到你会怀疑她。巡山执事出现前，她转身没入雨幕。",
      "background": "gate",
      "portrait": "linYue",
      "rain": true,
      "next": "c01.hub",
      "effects": [],
      "choices": []
    },
