  "nodes": [
    {
      "id": "case.intro",
      "chapter": "卷一 · 没有下山的人",
      "location": "弟子居所",
      "speaker": "旁白",
      "text": "阿澈的药还温着，人却不在屋里。你是外门弟子，平日替司籍房抄名册；阿澈住在隔屋，病了两日，这碗药是你替他领的。床底露着他那只开线的左脚鞋。昨夜他还说，病好了要找你报换新的。",
      "background": "quartersNight",
      "portrait": "",
      "rain": false,
      "effects": [],
      "choices": [],
      "next": "c01.manager"
    },
    {
      "id": "c01.manager",
      "chapter": "卷一 · 没有下山的人",
      "location": "弟子居所",
      "speaker": "旁白",
      "text": "管事把销名单拍在桌上：“家里有事，天亮前下山了。”你抄过离山手续：先从名册销名，再拿弟子入门时领的登仙帖去山门验印。阿澈病得走不稳，怎么连药都没带？管事催你准备明日考校，伸手收碗，却没碰那只鞋。",
      "background": "quartersNight",
      "portrait": "",
      "rain": false,
      "effects": [],
      "choices": [
        {
          "id": "askSeal",
          "text": "问：谁验了他的离山帖？",
          "target": "c01.seal",
          "effects": [],
          "conditions": [],
          "outcomes": []
        },
        {
          "id": "askRoad",
          "text": "问：病着走了哪条山路？",
          "target": "c01.road",
          "effects": [],
          "conditions": [],
          "outcomes": []
        }
      ]
    },
    {
      "id": "c01.seal",
      "chapter": "卷一 · 没有下山的人",
      "location": "弟子居所",
      "speaker": "旁白",
      "text": "“山门的事，去问守门人。”管事把销名单翻过去。你看见阿澈名字旁写着卯初，记下了时辰。他答的是谁管这件事，却没有答谁见过阿澈。",
      "background": "quartersNight",
      "portrait": "",
      "rain": false,
      "effects": [],
      "choices": [],
      "next": "c01.shoe"
    },
    {
      "id": "c01.road",
      "chapter": "卷一 · 没有下山的人",
      "location": "弟子居所",
      "speaker": "旁白",
      "text": "“北道。”管事说得很快。北道陡，阿澈昨夜发烧，连去医舍都走不稳。你记下这条路；光凭一只鞋，还不能证明他没走。",
      "background": "quartersNight",
      "portrait": "",
      "rain": false,
      "effects": [],
      "choices": [],
      "next": "c01.shoe"
    },
    {
      "id": "c01.shoe",
      "chapter": "卷一 · 没有下山的人",
      "location": "弟子居所",
      "speaker": "旁白",
      "text": "你把左鞋放回床边。鞋底开线，里面塞着半张擦药的纸。阿澈是忘了它，还是特意留下？先去查宗门说他离山时，本该留下的记录。",
      "background": "quartersNight",
      "portrait": "",
      "rain": false,
      "effects": [],
      "choices": [],
      "next": "c02.register"
    },
    {
      "id": "c02.register",
      "chapter": "卷一 · 没有下山的人",
      "location": "山门簿案",
      "speaker": "旁白",
      "text": "司籍房的销名册写“阿澈，卯初离山”。山门抄簿同一时辰却空着一格朱纹。离山弟子要先销名，再用灵力在门阵上验帖；朱纹是阵石留下的。",
      "background": "gate",
      "portrait": "",
      "rain": false,
      "effects": [],
      "choices": [],
      "next": "c02.compare"
    },
    {
      "id": "c02.compare",
      "chapter": "卷一 · 没有下山的人",
      "location": "山门簿案",
      "speaker": "旁白",
      "text": "守门人不许你碰原阵，只肯让你看抄簿。昨日另有一人回家；他的名字后有朱纹，帖边还有门阵烫出的焦痕。你把两人的记录摆在一起。",
      "background": "gate",
      "portrait": "",
      "rain": false,
      "effects": [],
      "choices": [
        {
          "id": "compare",
          "text": "拿昨日完整的朱纹，追问阿澈为何空印",
          "target": "c02.sound",
          "effects": [
            {
              "variable": "case.record",
              "operation": "set",
              "value": 1
            }
          ],
          "conditions": [],
          "outcomes": []
        },
        {
          "id": "accuse",
          "text": "追问管事是不是把阿澈藏起来了",
          "target": "c02.overreach",
          "effects": [
            {
              "variable": "case.overclaim",
              "operation": "set",
              "value": 1
            }
          ],
          "conditions": [],
          "outcomes": []
        },
        {
          "id": "medicine",
          "text": "拿昨夜的药碗问守门人",
          "target": "c02.medicine",
          "effects": [],
          "conditions": [],
          "outcomes": []
        }
      ]
    },
    {
      "id": "c02.overreach",
      "chapter": "卷一 · 没有下山的人",
      "location": "山门簿案",
      "speaker": "旁白",
      "text": "守门人把抄簿合上：“偏道也能下山。空一格，你就敢说谁藏人？”你说得太满，他不再让你看原页。昨日那人的完整朱纹，你已来得及抄下。",
      "background": "gate",
      "portrait": "",
      "rain": false,
      "effects": [],
      "choices": [],
      "next": "c02.sound"
    },
    {
      "id": "c02.medicine",
      "chapter": "卷一 · 没有下山的人",
      "location": "山门簿案",
      "speaker": "旁白",
      "text": "守门人摇头：“我没见他喝药，也不能靠一只碗替他走山门。”他把簿子推回半寸，许你抄下昨日真正离山者的朱纹。",
      "background": "gate",
      "portrait": "",
      "rain": false,
      "effects": [],
      "choices": [],
      "next": "c02.sound"
    },
    {
      "id": "c02.sound",
      "chapter": "卷一 · 没有下山的人",
      "location": "山门簿案",
      "speaker": "旁白",
      "text": "两份记录证明这一回少了验帖，不能证明阿澈如今在哪里。守门人在你的抄页上写下查阅时辰：“我没见他从正门出去，这句我肯认。”",
      "background": "gate",
      "portrait": "",
      "rain": false,
      "effects": [
        {
          "variable": "case.record",
          "operation": "set",
          "value": 1
        }
      ],
      "choices": [],
      "next": "c03.post"
    },
    {
      "id": "c03.post",
      "chapter": "卷一 · 没有下山的人",
      "location": "司籍房",
      "speaker": "旁白",
      "text": "回到司籍房，你取出自己的登仙帖。这是弟子验身份、出入山门用的凭帖；背面被刮薄的地方，灯下一照，竟露出一个“砚”字。你查到十年前的山灾册：阵师沈砚失踪，推定身故。旧帖可以重用，可为何偏偏刮掉他的名字？",
      "background": "registryOffice",
      "portrait": "",
      "rain": false,
      "effects": [],
      "choices": [
        {
          "id": "rubbing",
          "text": "先拓刮痕，保留原帖",
          "target": "c03.rubbing",
          "effects": [
            {
              "variable": "case.post",
              "operation": "set",
              "value": 1
            }
          ],
          "conditions": [],
          "outcomes": []
        },
        {
          "id": "ask",
          "text": "现在就拿帖问管事",
          "target": "c03.ask",
          "effects": [],
          "conditions": [],
          "outcomes": []
        }
      ]
    },
    {
      "id": "c03.rubbing",
      "chapter": "卷一 · 没有下山的人",
      "location": "司籍房",
      "speaker": "旁白",
      "text": "你用薄纸拓下残笔，原帖压进书页。拓片只能证明这张帖曾写过旧名；它还不能证明沈砚活着，更不能证明阿澈被谁带走。",
      "background": "registryOffice",
      "portrait": "",
      "rain": false,
      "effects": [],
      "choices": [],
      "next": "c04.cart"
    },
    {
      "id": "c03.ask",
      "chapter": "卷一 · 没有下山的人",
      "location": "司籍房",
      "speaker": "旁白",
      "text": "管事看了半眼：“旧帖省纸。你要查十年前的人，先把明日的符画好。”他收起帖，知道你在查旧名。陈闻后来仍能替你找一张旧号领单。",
      "background": "registryOffice",
      "portrait": "",
      "rain": false,
      "effects": [],
      "choices": [],
      "next": "c04.cart"
    },
    {
      "id": "c04.cart",
      "chapter": "卷一 · 没有下山的人",
      "location": "山腹坡道",
      "speaker": "旁白",
      "text": "傍晚，运药车从医舍出来。车沿挂一片包药纸，折角像只瘸鸟——昨夜阿澈笑过你这个手艺。坡道守卫拦住了你；纸可能只是医舍丢上车的。",
      "background": "mountainHeart",
      "portrait": "",
      "rain": false,
      "effects": [],
      "choices": [
        {
          "id": "keep",
          "text": "记车次，收起纸角",
          "target": "c04.keep",
          "effects": [
            {
              "variable": "case.cart",
              "operation": "set",
              "value": 1
            }
          ],
          "conditions": [],
          "outcomes": []
        },
        {
          "id": "challenge",
          "text": "当面逼问守卫车里是谁",
          "target": "c04.challenge",
          "effects": [
            {
              "variable": "case.guardAlert",
              "operation": "set",
              "value": 1
            }
          ],
          "conditions": [],
          "outcomes": []
        }
      ]
    },
    {
      "id": "c04.keep",
      "chapter": "卷一 · 没有下山的人",
      "location": "山腹坡道",
      "speaker": "旁白",
      "text": "车帘放下了，你没看见里面。车沿牌号与交接木牌写着同一趟车，夜里二更还要进山腹。你记下牌号，把纸角夹进簿里。要知道车上有没有阿澈，还得找能核对交接单的人。",
      "background": "mountainHeart",
      "portrait": "",
      "rain": false,
      "effects": [],
      "choices": [],
      "next": "c05.book"
    },
    {
      "id": "c04.challenge",
      "chapter": "卷一 · 没有下山的人",
      "location": "山腹坡道",
      "speaker": "旁白",
      "text": "守卫掀开空车厢的一角给你看：“药送进去，空车出来。够了吗？”他记住了你的脸，今夜侧门会多一次巡查。你仍没看见车进山腹时装了什么。",
      "background": "mountainHeart",
      "portrait": "",
      "rain": false,
      "effects": [],
