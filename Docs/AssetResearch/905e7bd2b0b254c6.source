_alt12_web.jpg", "width": "855", "height": "900", "filesize": "153039"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1917.25/1917.25_alt12_print.jpg", "width": "3230", "height": "3400", "filesize": "1663839"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1917.25/1917.25_alt12_full.tif", "width": "5499", "height": "5789", "filesize": "95529932"}, "date_created": "2017-03-13T14:39:49", "annotation": ""}], "creditline": "Worcester R. Warner Collection", "image_credit": null, "sketchfab_id": "6ccbd743fc8d480d91ee170b5f1a410d", "sketchfab_url": "https://sketchfab.com/models/6ccbd743fc8d480d91ee170b5f1a410d", "gallery_donor_text": null, "athena_id": 97604, "creators": [], "legal_status": "accessioned", "accession_date": "1916-12-20T00:00:00", "sortable_date": 1644, "date_added_to_oa": null, "date_text": "1644\u20131911", "collapse_artists": false, "on_loan": false, "recently_acquired": false, "record_type": "object", "conservation_statement": null, "has_conservation_images": false, "cover_accession_number": null, "is_nazi_era_provenance": false, "impression": null, "alternate_titles": [], "is_highlight": false, "updated_at": "2026-09-21 21:19:01.734000"}, {"id": 154086, "accession_number": "1988.20", "share_license_status": "CC0", "tombstone": "Landscape with Woodcutters Returning Home, 1200s. China, Southern Song dynasty (1127-1279). Hanging scroll, ink on silk; image: 124.5 x 58.3 cm (49 x 22 15/16 in.); overall: 203.2 x 81.3 cm (80 x 32 in.). The Cleveland Museum of Art, Leonard C. Hanna Jr. Fund, 1988.20", "current_location": null, "title": "Landscape with Woodcutters Returning Home", "creation_date": "1200s", "creation_date_earliest": 1200, "creation_date_latest": 1299, "artists_tags": [], "culture": ["China, Southern Song dynasty (1127-1279)"], "technique": "hanging scroll, ink on silk", "support_materials": [], "department": "Chinese Art", "collection": "ASIAN - Hanging scroll", "type": "Painting", "measurements": "Image: 124.5 x 58.3 cm (49 x 22 15/16 in.); Overall: 203.2 x 81.3 cm (80 x 32 in.)", "dimensions": {"image": {"height": 1.245, "height_inch": 49, "height_inch_fraction": 0.0, "width": 0.583, "width_inch": 22, "width_inch_fraction": 0.9375}, "overall": {"height": 2.032, "height_inch": 80, "height_inch_fraction": 0.0, "width": 0.813, "width_inch": 32, "width_inch_fraction": 0.0}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [{"inscription": "inscribed by Xuzhou Pudu \u865b\u821f\u666e\u5ea6", "inscription_translation": null, "inscription_remark": "", "sortorder": 1}], "exhibitions": {"current": [{"id": 311440, "title": "Notable Acquisitions", "description": "<i>Notable Acquisitions</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (June 7-September 15, 1991).", "opening_date": "1991-06-07T04:00:00"}, {"id": 211775, "title": "Highlights of Asian Paintings from The Cleveland Museum of Art", "description": "<i>Highlights of Asian Paintings from The Cleveland Museum of Art</i>. Nara National Museum (organizer) (February 21-March 29, 1998); Suntory Museum of Art (April 28-June 21, 1998).", "opening_date": "1998-02-21T00:00:00"}], "legacy": [{"description": "<em>Main Asian Rotation (Gallery 119)</em>. The Cleveland Museum of Art, Cleveland, OH (March 12-July 16, 2003).", "opening_date": "2003-03-12T05:00:00Z"}]}, "provenance": [{"description": "(Heisando Company, Limited, Tokyo, Japan, sold to the Cleveland Museum of Art)", "citations": [], "footnotes": null, "date": "?\u20131988", "sortorder": 1}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": null, "date": "1988\u2013", "sortorder": 2}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "A landscape with identical measurements in a Japanese private collection is also inscribed by Xuzhou. They may have been a pair of flanking scrolls in a triptych.", "early_education_description": null, "artlens_description": null, "description": "In late Song dynasty Chinese Chan Buddhist temples, paintings of landscapes, animals, or plants frequently took the place of deities. This hanging scroll features the humble life of woodcutters in nature an is in keeping with the Chan emphasis on simplicity and on the spiritual benefits of manual labor. executed in broad, quickly applied washes and punctuated by dark dots and texture strokes, the work is inscribed by Xuzhou Pudu, a priest at Wanshou temple near the Southern Song capital at Lin'an (modern Hangzhou).", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q60476296"], "internet_archive": ["https://archive.org/details/clevelandart-1988.20-landscape-with-woodc"]}, "citations": [{"citation": "Wilson, J. Keith. \"Notable Acquisitions.\" <em>The Bulletin of the Cleveland Museum of Art</em> 78, no. 3 (1991): 63-147.", "page_number": "Reproduced and Mentioned: p. 130", "url": "https://www.jstor.org/stable/25161319"}, {"citation": "<em>T\u014dy\u014d kaiga no seika: tokubetsuten: Kur\u012bvurando Bijutsukan no korekushon kara</em> [\u6771\u6d0b\u7d75\u753b\u306e\u7cbe\u83ef: \u7279\u522b\u5c55: \u30af\u30ea\u30fc\u30f4\u30e9\u30f3\u30c8\u7f8e\u8853\u9928\u306e\u30b3\u30ec\u30af\u30b7\u30e7\u30f3\u304b\u3089= Highlights of Asian painting from the Cleveland Museum of Art]. Nara, Japan: Nara National Museum, 1998.", "page_number": "p. 46, cat. no. 24", "url": ""}, {"citation": "Little, Stephen. <em>An Introduction to Chinese Paintings in the Los Angeles County Museum of Art.</em> Los Angeles : Art Catalogues : LACMA, 2017.", "page_number": "Mentioned and reproduced: pp. 14\u201315", "url": ""}], "url": "https://clevelandart.org/art/1988.20", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/1988.20/1988.20_web.jpg", "width": "430", "height": "900", "filesize": "97821", "filename": "1988.20_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1988.20/1988.20_print.jpg", "width": "1623", "height": "3400", "filesize": "1172404", "filename": "1988.20_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1988.20/1988.20_full.tif", "width": "3763", "height": "7885", "filesize": "89042424", "filename": "1988.20_full.tif"}}, "alternate_images": [{"web": {"url": "https://openaccess-cdn.clevelandart.org/1988.20/1988.20_alt0_web.jpg", "width": "327", "height": "900", "filesize": "92875"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1988.20/1988.20_alt0_print.jpg", "width": "1237", "height": "3400", "filesize": "992053"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1988.20/1988.20_alt0_full.tif", "width": "2845", "height": "7821", "filesize": "66782808"}, "date_created": "2015-09-28T13:52:04", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1988.20/1988.20_alt1_web.jpg", "width": "744", "height": "900", "filesize": "184057"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1988.20/1988.20_alt1_print.jpg", "width": "2809", "height": "3400", "filesize": "2858446"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1988.20/1988.20_alt1_full.tif", "width": "5028", "height": "6086", "filesize": "91830524"}, "date_created": "2015-09-28T13:35:43", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1988.20/1988.20_alt2_web.jpg", "width": "403", "height": "893", "filesize": "275720"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1988.20/1988.20_alt2_print.jpg", "width": "1535", "height": "3400", "filesize": "3502371"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1988.20/1988.20_alt2_full.tif", "width": "2257", "height": "5000", "filesize": "33869064"}, "date_created": "2004-08-24T13:34:30", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1988.20/1988.20_alt3_web.jpg", "width": "403", "height": "893", "filesize": "278985"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1988.20/1988.20_alt3_print.jpg", "width": "1535", "height": "3400", "filesize": "3483188"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1988.20/1988.20_alt3_full.tif", "width": "2257", "height": "5000", "filesize": "33868516"}, "annotation": ""}], "creditline": "Leonard C. Hanna Jr. Fund", "image_credit": null, "sketchfab_id": null, "sketchfab_url": null, "gallery_donor_text": null, "athena_id": 154086, "creators": [], "legal_status": "accessioned", "accession_date": "1988-04-07T00:00:00", "sortable_date": 1200, "date_added_to_oa": null, "date_text": "1200s", "collapse_artists": false, "on_loan": false, "recently_acquired": false, "record_type": "object", "conservation_statement": null, "has_conservation_images": false, "cover_accession_number": null, "is_nazi_era_provenance": false, "impression": null, "alternate_titles": [], "is_highlight": false, "updated_at": "2026-05-29 07:58:05.076000"}, {"id": 160947, "accession_number": "1999.216.1", "share_license_status": "CC0", "tombstone": "Herdboys and Buffalo in Landscape (\u7267\u725b\u5716), 1200s. Guo Min (Chinese, mid-late 1200s). Hanging scroll; ink on silk; image: 92 x 56.5 cm (36 1/4 x 22 1/4 in.); overall with knobs: 196 x 76 cm (77 3/16 x 29 15/16 in.). The Cleveland Museum of Art, John L. Severance Fund, 1999.216.1", "current_location": null, "title": "Herdboys and Buffalo in Landscape", "title_in_original_language": "\u7267\u725b\u5716", "creation_date": "1200s", "creation_date_earliest": 1250, "creation_date_latest": 1285, "artists_tags": ["male"], "culture": ["China, Qixian, Yuan dynasty (1271-1368)"], "technique": "Hanging scroll; ink on silk", "support_materials": [], "department": "Chinese Art", "collection": "ASIAN - Hanging scroll", "type": "Painting", "measurements": "Image: 92 x 56.5 cm (36 1/4 x 22 1/4 in.); Overall with knobs: 196 x 76 cm (77 3/16 x 29 15/16 in.)", "dimensions": {"image": {"height": 0.92, "height_inch": 36, "height_inch_fraction": 0.25, "width": 0.565, "width_inch": 22, "width_inch_fraction": 0.25}, "overall": {"height": 1.96, "height_inch": 77, "height_inch_fraction": 0.1875, "width": 0.7, "width_inch": 27, "width_inch_fraction": 0.5625}, "overall with knobs": {"height": 1.96, "height_inch": 77, "height_inch_fraction": 0.1875, "width": 0.76, "width_inch": 29, "width_inch_fraction": 0.9375}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [{"inscription": "\u52aa\u529b\u9084\u76f8\u9b2a\uff0c\u722d\u5f37\u4e0d\u81ea\u5b89\u3002 \n\u7267\u7ae5\u9591\u9000\u7acb\uff0c\u89e3\u5e36\u975c\u4e2d\u770b\u3002 \n\u4f2f\u9054", "inscription_translation": "Inscription at upper right:\n\nThe bulls are engaged in fighting,  \nCautiously, each seeks to overcome the other. \nThe herdboy calmly stands by.  \nUntying his belt, he silently watches. \nSigned \"Boda\"", "inscription_remark": null, "sortorder": null}], "exhibitions": {"current": [{"id": 448467, "title": "China through the Magnifying Glass: Masterpieces in Miniature and Detail", "description": "<i>China through the Magnifying Glass: Masterpieces in Miniature and Detail</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (December 11, 2022-February 26, 2023).", "opening_date": "2022-12-10T05:00:00"}], "legacy": [{"description": "<em>Main Asian Rotation (Gallery 242)</em>. The Cleveland Museum of Art, Cleveland, OH (July 28, 2014-January 7, 2015).", "opening_date": "2014-07-28T00:00:00"}]}, "provenance": [{"description": "Shokado Shojo \u677e\u82b1\u5802\u662d\u4e57 [1584\u20131639], Japan", "citations": [], "footnotes": [], "date": null, "sortorder": 1}, {"description": "Otokoyama Hachiman-gu \u7537\u5c71\u516b\u5e61\u5bae, Kyoto, Japan", "citations": [], "footnotes": [], "date": null, "sortorder": 2}, {"description": "Baron Morimura Kaisaku \u7537\u7235 \u68ee\u6751\u958b\u4f5c [1873\u20131962], Japan", "citations": [], "footnotes": [], "date": null, "sortorder": 3}, {"description": "(Kaikodo America Inc., New York, NY, sold to the Cleveland Museum of Art)", "citations": [], "footnotes": [], "date": "?\u20131999", "sortorder": 4}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": [], "date": "1999\u2013", "sortorder": 5}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "Tending water buffalos has traditionally been the task of young boys and can still be seen in rural areas of Southern China today.", "early_education_description": null, "artlens_description": null, "description": "Herdboys tend their buffalo in a bucolic landscape by a winding stream. Guo Min emphasizes the massive forms and mighty power of the animals, transforming them into forces of nature. <br><br>The poem on this scroll reads: \"The bulls are engaging in fighting, Cautiously, each seeks to overcome the other. The herdboy calmly stands by. Untying his belt, he silently watches.\"", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q60477825"], "internet_archive": ["https://archive.org/details/clevelandart-1999.216.1-herdboys-and-buffalo"]}, "citations": [{"citation": "<em>Kokka</em> no. 355 (1919) pp. 202-206.", "page_number": "pp. 202-206", "url": null}, {"citation": "Harada, Kinjiro\u0304 \u539f\u7530\u8b39\u6b21\u90ce. <em>Nihon genzai Shina meiga mokuroku</em>\u65e5\u672c\u73fe\u5728\u652f\u90a3\u540d\u756b\u76ee\u9304. To\u0304kyo\u0304: O\u0304tsuka Ko\u0304geisha, 1938.", "page_number": "p. 124", "url": null}, {"citation": "<em>Kaikodo </em>(Autumn 1999), no. 2, pp. 94-95, 246-49.", "page_number": "pp. 94-95, 246-49", "url": null}, {"citation": "Chou, Ju-hsi and Anita Chung. <em>Silent poetry: Chinese paintings from the collection of the Cleveland Museum of Art</em>. Cleveland, OH: Cleveland Museum of Art, 2015.", "page_number": "Reproduced: pp. 97-99", "url": null}, {"citation": "Chou, Ju-hsi and Anita Chung. <em>Silent poetry: Chinese paintings from the collection of the Cleveland Museum of Art</em>. Cleveland, OH: The Cleveland Museum of Art, 2015.", "page_number": "Mentioned: p. 99", "url": null}], "url": "https://clevelandart.org/art/1999.216.1", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_web.jpg", "width": "551", "height": "893", "filesize": "306557", "filename": "1999.216.1_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_print.jpg", "width": "2097", "height": "3400", "filesize": "4926202", "filename": "1999.216.1_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_full.tif", "width": "3886", "height": "6301", "filesize": "73488412", "filename": "1999.216.1_full.tif"}}, "alternate_images": [{"web": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_alt0_web.jpg", "width": "353", "height": "900", "filesize": "190886"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_alt0_print.jpg", "width": "1335", "height": "3400", "filesize": "1408779"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_alt0_full.tif", "width": "2600", "height": "6622", "filesize": "51676140"}, "date_created": "2010-01-15T16:03:20", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_alt1_web.jpg", "width": "535", "height": "893", "filesize": "333901"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_alt1_print.jpg", "width": "2038", "height": "3400", "filesize": "5162771"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_alt1_full.tif", "width": "4096", "height": "6832", "filesize": "83973580"}, "date_created": "2009-12-09T01:04:56", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_alt2_web.jpg", "width": "694", "height": "893", "filesize": "494608"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_alt2_print.jpg", "width": "2643", "height": "3400", "filesize": "7257686"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_alt2_full.tif", "width": "3856", "height": "4960", "filesize": "57399268"}, "date_created": "2009-12-09T01:05:35", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_alt3_web.jpg", "width": "900", "height": "665", "filesize": "251989"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_alt3_print.jpg", "width": "3400", "height": "2514", "filesize": "4062685"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_alt3_full.tif", "width": "6816", "height": "5040", "filesize": "103082524"}, "date_created": "2009-12-09T01:06:11", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_alt4_web.jpg", "width": "531", "height": "893", "filesize": "38638"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_alt4_print.jpg", "width": "1218", "height": "2048", "filesize": "206752"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.1/1999.216.1_alt4_full.tif", "width": "1218", "height": "2048", "filesize": "225050"}, "annotation": ""}], "creditline": "John L. Severance Fund", "image_credit": null, "sketchfab_id": null, "sketchfab_url": null, "gallery_donor_text": null, "athena_id": 160947, "creators": [{"id": 36734, "description": "Guo Min (Chinese, mid-late 1200s)", "extent": null, "qualifier": null, "role": "artist", "biography": null, "name_in_original_language": "\u90ed\u654f", "use_in_caption": true, "include_extent": false, "weight": 1}], "legal_status": "accessioned", "accession_date": "1999-12-06T00:00:00", "sortable_date": 1250, "date_added_to_oa": null, "date_text": "1200s", "collapse_artists": false, "on_loan": false, "recently_acquired": false, "record_type": "component", "conservation_statement": null, "has_conservation_images": false, "cover_accession_number": "1999.216", "is_nazi_era_provenance": false, "impression": null, "alternate_titles": ["Herdboys and Oxen in Landscape (right)", "Herdboys and Buffalo in Landscape"], "is_highlight": false, "updated_at": "2026-06-25 11:12:55.196000"}, {"id": 160948, "accession_number": "1999.216.2", "share_license_status": "CC0", "tombstone": "Herdboys and Buffalo in Landscape (\u7267\u725b\u5716), 1200s. Guo Min (Chinese, mid-late 1200s). Hanging scroll; ink on silk; image: 91 x 56 cm (35 13/16 x 22 1/16 in.); overall with knobs: 193 x 75.4 cm (76 x 29 11/16 in.). The Cleveland Museum of Art, John L. Severance Fund, 1999.216.2", "current_location": null, "title": "Herdboys and Buffalo in Landscape", "title_in_original_language": "\u7267\u725b\u5716", "creation_date": "1200s", "creation_date_earliest": 1250, "creation_date_latest": 1285, "artists_tags": ["male"], "culture": ["China, Qixian, Yuan dynasty (1271-1368)"], "technique": "Hanging scroll; ink on silk", "support_materials": [], "department": "Chinese Art", "collection": "ASIAN - Hanging scroll", "type": "Painting", "measurements": "Image: 91 x 56 cm (35 13/16 x 22 1/16 in.); Overall with knobs: 193 x 75.4 cm (76 x 29 11/16 in.)", "dimensions": {"image": {"height": 0.91, "height_inch": 35, "height_inch_fraction": 0.8125, "width": 0.56, "width_inch": 22, "width_inch_fraction": 0.0625}, "overall": {"height": 1.93, "height_inch": 76, "height_inch_fraction": 0.0, "width": 0.696, "width_inch": 27, "width_inch_fraction": 0.375}, "overall with knobs": {"height": 1.93, "height_inch": 76, "height_inch_fraction": 0.0, "width": 0.754, "width_inch": 29, "width_inch_fraction": 0.6875}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [{"inscription": "\u9f4a\u5411\u4e2d\u6d41\u6e21\uff0c\u90a3\u77e5\u884c\u8def\u96e3\u3002\n\u524d\u6751\u9752\u8349\u9577\uff0c\u7159\u96e8\u25a1\u6f2b\u6f2b\u3002\n\u4f2f\u9054", "inscription_translation": "Inscription at upper right:\n\nTogether, they wade through the middle of the stream, \nMindless of perils in the journey. \nThe grass grows tall in the village ahead, \nWhile the mist and rain spread far and wide. \nSigned \u201cBoda\u201d", "inscription_remark": "The \u201c\u25a1\u201d indicates a lost word.", "sortorder": null}], "exhibitions": {"current": [{"id": 448467, "title": "China through the Magnifying Glass: Masterpieces in Miniature and Detail", "description": "<i>China through the Magnifying Glass: Masterpieces in Miniature and Detail</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (December 11, 2022-February 26, 2023).", "opening_date": "2022-12-10T05:00:00"}], "legacy": [{"description": "<em>Main Asian Rotation (Gallery 242)</em>. The Cleveland Museum of Art, Cleveland, OH (July 28, 2014-January 7, 2015).", "opening_date": "2014-07-28T00:00:00"}]}, "provenance": [{"description": "Shokado Shojo \u677e\u82b1\u5802\u662d\u4e57 [1584\u20131639], Japan", "citations": [], "footnotes": [], "date": null, "sortorder": 1}, {"description": "Otokoyama Hachiman-gu \u7537\u5c71\u516b\u5e61\u5bae, Kyoto, Japan", "citations": [], "footnotes": [], "date": null, "sortorder": 2}, {"description": "Baron Morimura Kaisaku \u7537\u7235 \u68ee\u6751\u958b\u4f5c [1873\u20131962], Japan", "citations": [], "footnotes": [], "date": null, "sortorder": 3}, {"description": "(Kaikodo America Inc., New York, NY, sold to the Cleveland Museum of Art)", "citations": [], "footnotes": [], "date": "?\u20131999", "sortorder": 4}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": [], "date": "1999\u2013", "sortorder": 5}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "Tending water buffalos has traditionally been the task of young boys and can still be seen in rural areas of Southern China today.", "early_education_description": null, "artlens_description": null, "description": "Herdboys tend their buffalo in a bucolic landscape by a winding stream. Guo Min emphasizes the massive forms and mighty power of the animals, transforming them into forces of nature. <br><br>The poem on this scroll reads: \"Together, they wade through the middle of the stream, Mindless of perils in the journey. The grass grows tall in the village ahead, While the mist and rain spread far and wide.\"", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q60477837"], "internet_archive": ["https://archive.org/details/clevelandart-1999.216.2-herdboys-and-buffalo"]}, "citations": [{"citation": "<em>Kokka </em>no. 355 (1919) pp. 202-206.", "page_number": "pp. 202-206", "url": null}, {"citation": "Harada, Kinjiro\u0304 \u539f\u7530\u8b39\u6b21\u90ce. <em>Nihon genzai Shina meiga mokuroku</em>\u65e5\u672c\u73fe\u5728\u652f\u90a3\u540d\u756b\u76ee\u9304. To\u0304kyo\u0304: O\u0304tsuka Ko\u0304geisha, 1938.", "page_number": "p. 124", "url": null}, {"citation": "<em>Kaikodo </em>(Autumn 1999), no. 2, pp. 94-95, 246-49.", "page_number": "pp. 94-95, 246-49", "url": null}, {"citation": "Chou, Ju-hsi and Anita Chung. <em>Silent poetry: Chinese paintings from the collection of the Cleveland Museum of Art</em>. Cleveland, OH: Cleveland Museum of Art, 2015.", "page_number": "Reproduced: pp. 97-99", "url": null}, {"citation": "Chou, Ju-hsi and Anita Chung. <em>Silent poetry: Chinese paintings from the collection of the Cleveland Museum of Art</em>. Cleveland, OH: The Cleveland Museum of Art, 2015.", "page_number": "Mentioned: p. 99", "url": null}], "url": "https://clevelandart.org/art/1999.216.2", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_web.jpg", "width": "568", "height": "900", "filesize": "193433", "filename": "1999.216.2_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_print.jpg", "width": "2144", "height": "3400", "filesize": "2025342", "filename": "1999.216.2_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_full.tif", "width": "3904", "height": "6191", "filesize": "72533236", "filename": "1999.216.2_full.tif"}}, "alternate_images": [{"web": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_alt0_web.jpg", "width": "353", "height": "893", "filesize": "239904"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_alt0_print.jpg", "width": "1343", "height": "3400", "filesize": "3311128"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_alt0_full.tif", "width": "2570", "height": "6506", "filesize": "50192672"}, "date_created": "2010-01-15T16:36:26", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_alt1_web.jpg", "width": "562", "height": "893", "filesize": "364142"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_alt1_print.jpg", "width": "2138", "height": "3400", "filesize": "5207907"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_alt1_full.tif", "width": "4104", "height": "6528", "filesize": "80394604"}, "date_created": "2009-12-09T01:07:07", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_alt2_web.jpg", "width": "670", "height": "893", "filesize": "462037"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_alt2_print.jpg", "width": "2550", "height": "3400", "filesize": "7436367"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_alt2_full.tif", "width": "3408", "height": "4544", "filesize": "46479476"}, "date_created": "2009-12-09T01:07:39", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_alt3_web.jpg", "width": "1263", "height": "668", "filesize": "590790"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_alt3_print.jpg", "width": "3400", "height": "1798", "filesize": "4384445"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_alt3_full.tif", "width": "6688", "height": "3536", "filesize": "70968196"}, "date_created": "2009-12-09T01:08:10", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_alt4_web.jpg", "width": "560", "height": "893", "filesize": "43340"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_alt4_print.jpg", "width": "1285", "height": "2048", "filesize": "236809"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1999.216.2/1999.216.2_alt4_full.tif", "width": "1285", "height": "2048", "filesize": "255394"}, "annotation": ""}], "creditline": "John L. Severance Fund", "image_credit": null, "sketchfab_id": null, "sketchfab_url": null, "gallery_donor_text": null, "athena_id": 160948, "creators": [{"id": 36734, "description": "Guo Min (Chinese, mid-late 1200s)", "extent": null, "qualifier": null, "role": "artist", "biography": null, "name_in_original_language": "\u90ed\u654f", "use_in_caption": true, "include_extent": false, "weight": 1}], "legal_status": "accessioned", "accession_date": "1999-12-06T00:00:00", "sortable_date": 1250, "date_added_to_oa": null, "date_text": "1200s", "collapse_artists": false, "on_loan": false, "recently_acquired": false, "record_type": "component", "conservation_statement": null, "has_conservation_images": false, "cover_accession_number": "1999.216", "is_nazi_era_provenance": false, "impression": null, "alternate_titles": ["Herdboys and Oxen in Landscape (left)"], "is_highlight": false, "updated_at": "2026-06-25 11:12:55.204000"}, {"id": 132016, "accession_number": "1954.583", "share_license_status": "CC0", "tombstone": "Landscape after Ni Zan (\u4eff\u502a\u74da\u8a2d\u8272\u5c71\u6c34\u5716), 1707. Wang Yuanqi (Chinese, 1642\u20131715). Hanging scroll; ink and light color on paper; painting: 80.6 x 43.8 cm (31 3/4 x 17 1/4 in.); overall with knobs: 217.7 x 68.5 cm (85 11/16 x 26 15/16 in.). The Cleveland Museum of Art, John L. Severance Fund, 1954.583", "current_location": null, "title": "Landscape after Ni Zan", "title_in_original_language": "\u4eff\u502a\u74da\u8a2d\u8272\u5c71\u6c34\u5716", "creation_date": "1707", "creation_date_earliest": 1707, "creation_date_latest": 1707, "artists_tags": ["male"], "culture": ["China, Qing dynasty (1644\u20131911)"], "technique": "Hanging scroll; ink and light color on paper", "support_materials": [], "department": "Chinese Art", "collection": "ASIAN - Hanging scroll", "type": "Painting", "measurements": "Painting: 80.6 x 43.8 cm (31 3/4 x 17 1/4 in.); Overall with knobs: 217.7 x 68.5 cm (85 11/16 x 26 15/16 in.)", "dimensions": {"painting": {"height": 0.806, "height_inch": 31, "height_inch_fraction": 0.75, "width": 0.438, "width_inch": 17, "width_inch_fraction": 0.25}, "overall with knobs": {"height": 2.177, "height_inch": 85, "height_inch_fraction": 0.6875, "width": 0.685, "width_inch": 26, "width_inch_fraction": 0.9375}, "overall": {"height": 2.177, "height_inch": 85, "height_inch_fraction": 0.6875, "width": 0.589, "width_inch": 23, "width_inch_fraction": 0.1875}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [{"inscription": "[\u5370]\u7a40\u8a52\u5802\u3002\n\u4e01\u4ea5\u6e05\u548c\u6248\u5f9e\u6b78\u821f\u5beb\u8a2d\u8272\u96f2\u6797", "inscription_translation": "Artist's inscription and seal: \n\n[seal] Gi yi tang. \n[Inscription 1] On a day of mild weather, in the year of dinghai [1707], [I painted this]\u2014a Ni Zan in color\u2014after having been in the imperial entourage and returned to the boat in the aftermath.", "inscription_remark": "The Kangxi Emperor made his sixth Southern Inspection tour from the twenty-second day of the first month through the twenty-second day of the fifth month in 1707, the dinghai year. Wang Yuanqi was apparently in attendance on the tour.", "sortorder": 1}, {"inscription": "\u4f59\u5e74\u4f86\u4e00\u53cb\u530f\u7cfb\uff0c\u7c2a\u7b46\u9e7f\u9e7f\u3002\u5919\u591c\u5728\u516c\u3002\u5bb6\u7121\u7511\u77f3\uff0c\u65e5\u5728\u6101\u57ce\u82e6\u6d77\u4e2d\u3002\u7121\u4ee5\u89e3\u6182\u3002\u60df\u5f04\u67d4\u7ff0\u51fa\u5165\u5b8b\u5143\u8af8\u5bb6\uff0c\u5982\u5c0d\u53e4\u4eba\u3002\u96d6\u4e0d\u80fd\u8096\u5176\u5f62\u795e\uff0c\u5eb6\u5e7e\u4e00\u9047\uff0c\u4ea6\u5bd3\u610f\u5bec\u5fc3\u4e4b\u6cd5\u4e5f\u3002\u9e93\u81fa\u3002[\u5370]\u539f\u7941\u4e4b\u5370; \u9e93\u81fa\n\n [\u5370, \u53f3\u4e0b]\u897f\u5eec\u5f8c\u4eba", "inscription_translation": "Artist's inscription, signature, and 3 seals: \n\n[Inscription 2] During the year, I have been living like a hanging gourd\u2014alone and without friends. I stuck my brush in my hair and was much like a common man. I have been spending day and night in the office, seldom dining at home. Day by day, I spent my life in the city of melancholy and the ocean of bitterness. There were few ways to relieve my frustrations except to resort to my brush so that I could move in and out amid the Song and Yuan masters as if virtually coming face to face with these men of yore. Even though I could not achieve a perfect resemblance in form and spirit, this comes as close to an encounter while also affording me a means to record my thoughts and to relax my mind. Lutai. [2 seals] Yuanqi zhi yin; Lutai.\n\n[seal at the lower right corner] Xi lu hou ren.", "inscription_remark": null, "sortorder": 2}, {"inscription": "1 additional seal of Pang Yuanji \u9f90\u5143\u6fdf (1864\u20131949) at the lower left corner.", "inscription_translation": null, "inscription_remark": null, "sortorder": 3}], "exhibitions": {"current": [{"id": 300427, "title": "Chinese Landscape Painting", "description": "<i>Chinese Landscape Painting</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (November 5-December 26, 1954).", "opening_date": "1954-11-05T04:00:00"}, {"id": 377849, "title": "1000 Jahre Chinesische Malerei", "description": "<i>1000 Jahre Chinesische Malerei</i>. Haus der Kunst, Munich, M\u00f9nich, Germany (organizer) (October 16-December 13, 1959).", "opening_date": "1959-10-16T04:00:00"}, {"id": 519277, "title": "Chinese Art", "description": "<i>Chinese Art</i>. Smith College Museum of Art, Northampton, MA (organizer) (January 8-26, 1962).", "opening_date": "1962-01-08T05:00:00"}, {"id": 304517, "title": "Eight Dynasties of Chinese Painting", "description": "<i>Eight Dynasties of Chinese Painting</i>. The Nelson-Atkins Museum of Art (November 7, 1980-January 4, 1981); The Cleveland Museum of Art (February 11-March 29, 1981); Tokyo National Museum (October 4-November 17, 1982); The Asia Society Museum, New York, NY (December 3, 1982-February 28, 1983).", "opening_date": "1981-02-11T05:00:00"}, {"id": 539332, "title": "Six Dynasties of Chinese Painting (Chinese art rotation)", "description": "<i>Six Dynasties of Chinese Painting (Chinese art rotation)</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (November 10, 2023-May 5, 2024).", "opening_date": "2023-11-10T05:00:00"}], "legacy": [{"description": "<em>Chinese Landscape Painting</em>. The Cleveland Museum of Art, Cleveland, OH (organizer) (November 5-December 26, 1954).", "opening_date": "1954-11-05T05:00:00Z"}, {"description": "<em>Chinese Paintings</em>. The Cleveland Museum of Art, Cleveland, OH (1962).", "opening_date": "1962-01-01T05:00:00Z"}, {"description": "<em>Main Asian Rotation (Gallery 119)</em>. The Cleveland Museum of Art, Cleveland, OH (August 14-November 25, 2002).", "opening_date": "2002-08-14T04:00:00Z"}, {"description": "<em>Main Asian Rotation (Gallery 119)</em>. The Cleveland Museum of Art, Cleveland, OH (July 13-November 17, 2004).", "opening_date": "2004-07-13T04:00:00Z"}]}, "provenance": [{"description": "Pang Yuanji \u9f90\u5143\u6fdf [1864\u20131949]", "citations": [], "footnotes": [], "date": "by 1909\u2013?", "sortorder": 1}, {"description": "(Walter Hochstadter [1914\u20132007], New York, NY, sold to the Cleveland Museum of Art)", "citations": [], "footnotes": [], "date": "?\u20131954", "sortorder": 2}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": [], "date": "1954\u2013", "sortorder": 3}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": null, "early_education_description": null, "artlens_description": null, "description": "Wang Yuanqi, an official in Emperor Kangxi\u2019s (reigned 1662\u20131722) court, grew up in an artistic family. Like other mainstream painters of the Orthodox School, he followed a canon of earlier styles and artists endorsed by Ming calligrapher Dong Qichang (1555\u20131636). <br> <br>Here, Wang drew inspiration from Ni Zan (1301\u20131374), a Yuan dynasty painter known for his simple compositions and spare use of ink. Master Ni seldom used color, but Wang added green and ochre washes to the trees, cottages, and hills in this landscape. Painting was a way for Wang to relieve the pressures of his official duties.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q60516498"], "internet_archive": ["https://archive.org/details/clevelandart-1954.583-landscape-in-the-col", "https://archive.org/details/clevelandart-1954.583-landscape-in-color-a", "https://archive.org/details/clevelandart-1954.583-landscape-after-ni-z"]}, "citations": [{"citation": "Pang, Yuanji \u9f90\u5143\u6fdf. <em>Xu zhai ming hua lu (16 juan)</em> [\u865b\u9f4b\u540d\u756b\u9304 (16\u5377) = Catalogue of paintings in the collection of the author]. Shanghai: Xuantong ji you, 1909.", "page_number": "Mentioned: vol. IX, Wang Yuan-ch'i 15(b)-15(a), pp. 42(b)\u201343(a)", "url": null}, {"citation": "Pang, Yuanji \u9f90\u5143\u6fdf and Binglu\u0308 Pang \u9f90\u6c37\u5c65. <em>Ming bi ji sheng </em>[\u540d\u7b46\u96c6\u52dd = Illustrated catalogue of Chinese paintings in the author's collection]. Shanghai: Mo yuan tang, 1940.", "page_number": "Reproduced: I, pl. 14", "url": null}, {"citation": "Lee, Sherman E. <em>Chinese Landscape Painting</em>. 1954.", "page_number": "Mentioned: p. 154, cat. 86; Reproduced: p. 106", "url": "https://archive.org/details/ChineseLandscape"}, {"citation": "Sire\u0301n, Osvald. <em>Chinese Painting: Leading Masters and Principles</em>. New York: Ronald Press, 1956.", "page_number": "Mentioned: VII, Lists, 441", "url": null}, {"citation": "The Cleveland Museum of Art. <em>The Cleveland Museum of Art Handbook.</em> Cleveland, OH: The Cleveland Museum of Art, 1958.", "page_number": "Mentioned and Reproduced: cat. no. 878", "url": "https://archive.org/details/CMAHandbook1958/page/n156"}, {"citation": "Goepper, Roger. <em>1000 Jahre chinesische Malerei</em>. Mu\u0308nchen: Haus der Kunst, 1959.", "page_number": "cat. no. 95", "url": null}, {"citation": "<em>Chinese Art: An Exhibition of Paintings, Jades, Bronzes and Ceramics: Being a Contribution Made by Smith College Museum of Art to the College Interim Session, 1962</em>. Northampton, MA: [The Museum], 1962.", "page_number": "cat. no. 29", "url": null}, {"citation": "Lee, Sherman E. <em>Chinese Landscape Painting</em>. Cleveland, OH: The Cleveland Museum of Art, 1962.", "page_number": "Mentioned and Reproduced: p. 100, color pl. VI, no. 80", "url": null}, {"citation": "Lee, Sherman E. <em>A History of Far Eastern Art</em>. New York: H.N. Abrams, 1964.", "page_number": "Mentioned and Reproduced: p. 444, fig. 588", "url": null}, {"citation": "Sullivan, Michael.<em> Chinese and Japanese Art</em>. New York: Grolier, 1965.", "page_number": "Mentioned and Reproduced: p. 91, color pl. 195", "url": null}, {"citation": "The Cleveland Museum of Art. <em>Handbook of the Cleveland Museum of Art/1966</em>. Cleveland, OH: The Cleveland Museum of Art, 1966.", "page_number": "Reproduced: p. 269", "url": "https://archive.org/details/CMAHandbook1966/page/n293"}, {"citation": "The Cleveland Museum of Art. <em>Handbook of the Cleveland Museum of Art/1969</em>. Cleveland, OH: The Cleveland Museum of Art, 1969.", "page_number": "Reproduced: p. 269", "url": "https://archive.org/details/CMAHandbook1969/page/n293"}, {"citation": "Kuo, Chi-sheng. \"Wang Yuan-ch'i te shan-shui hua i-shu\" [The landscape style of Wang Yuan-ch'i}. <em>National Palace Museum Quarterly</em> \u6545\u5bae\u5b63\u520a, VIII, no. 4, pp. 17\u201352; English summary, pp. 7\u201310.", "page_number": "Mentioned and Reproduced: p. 29, pls. 21, 21-A, 21-B", "url": null}, {"citation": "The Cleveland Museum of Art. <em>Handbook of the Cleveland Museum of Art/1978</em>. Cleveland, OH: The Cleveland Museum of Art, 1978.", "page_number": "Reproduced: p. 358", "url": "https://archive.org/details/CMAHandbook1978/page/n378"}, {"citation": "Hironobu Kohara \u53e4\u539f\u5b8f\u4f38, Tamaki Ogawa \u5c0f\u5ddd\u74b0\u6a39, and Roderick Whitfield. <em>Un Juhei, O\u0304 Ki</em> \u60f2\u58fd\u5e73 \u738b\u7fec. To\u0304kyo\u0304: Chu\u0304o\u0304 Ko\u0304ronsha, 1979.", "page_number": "Mentioned and Reproduced: p. 187, pl. 87", "url": null}, {"citation": "Ho, Wai-kam, Sherman E. Lee, Laurence Sickman, and Marc F. Wilson. <em>Eight Dynasties of Chinese Painting: The Collections of the Nelson Gallery-Atkins Museum, Kansas City, and the Cleveland Museum of Art</em>. Cleveland, OH: Cleveland Museum of Art, in cooperation with Indiana University Press, 1980.", "page_number": "Mentioned and Reproduced: cat. no. 251, pp. 339\u2013340", "url": null}, {"citation": "Chou, Ju-hsi and Anita Chung. <em>Silent poetry: Chinese paintings from the collection of the Cleveland Museum of Art</em>. Cleveland, OH: The Cleveland Museum of Art, 2015.", "page_number": "Mentioned and Reproduced: pp. 419\u2013424", "url": null}], "url": "https://clevelandart.org/art/1954.583", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/1954.583/1954.583_web.jpg", "width": "500", "height": "893", "filesize": "352090", "filename": "1954.583_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1954.583/1954.583_print.jpg", "width": "1905", "height": "3400", "filesize": "5185657", "filename": "1954.583_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1954.583/1954.583_full.tif", "width": "3674", "height": "6555", "filesize": "72277744", "filename": "1954.583_full.tif"}}, "alternate_images": [{"web": {"url": "https://openaccess-cdn.clevelandart.org/1954.583/1954.583_alt0_web.jpg", "width": "277", "height": "893", "filesize": "167352"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1954.583/1954.583_alt0_print.jpg", "width": "1055", "height": "3400", "filesize": "2621345"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1954.583/1954.583_alt0_full.tif", "width": "1986", "height": "6395", "filesize": "38127228"}, "date_created": "2010-05-07T12:22:56", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1954.583/1954.583_alt1_web.jpg", "width": "507", "height": "893", "filesize": "334958"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1954.583/1954.583_alt1_print.jpg", "width": "1930", "height": "3400", "filesize": "3977758"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1954.583/1954.583_alt1_full.tif", "width": "2838", "height": "5000", "filesize": "42585976"}, "date_created": "2004-04-02T20:17:52", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1954.583/1954.583_alt2_web.jpg", "width": "507", "height": "893", "filesize": "318335"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1954.583/1954.583_alt2_print.jpg", "width": "1930", "height": "3400", "filesize": "3683018"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1954.583/1954.583_alt2_full.tif", "width": "2838", "height": "5000", "filesize": "42590180"}, "annotation": ""}], "creditline": "John L. Severance Fund", "image_credit": null, "sketchfab_id": null, "sketchfab_url": null, "gallery_donor_text": null, "athena_id": 132016, "creators": [{"id": 23295, "description": "Wang Yuanqi (Chinese, 1642\u20131715)", "extent": null, "qualifier": null, "role": "artist", "biography": null, "name_in_original_language": "\u738b\u539f\u7941", "birth_year": "1642", "death_year": "1715", "use_in_caption": true, "include_extent": false, "weight": 1}], "legal_status": "accessioned", "accession_date": "1954-08-11T00:00:00", "sortable_date": 1707, "date_added_to_oa": null, "date_text": "1707", "collapse_artists": false, "on_loan": false, "recently_acquired": false, "record_type": "object", "conservation_statement": null, "has_conservation_images": false, "cover_accession_number": null, "is_nazi_era_provenance": false, "impression": null, "alternate_titles": ["Landscape in the Color Style of Ni Tsan", "Landscape in the Color Style of Ni Zan \u4eff\u502a\u74da\u8a2d\u8272\u5c71\u6c34\u5716", "Landscape After Ni Tsan", "Landscape in the Color Style of Ni Zan", "Landscape in Color after Ni Zan"], "is_highlight": false, "updated_at": "2026-08-08 11:04:25.330000"}, {"id": 132926, "accession_number": "1955.37.4", "share_license_status": "CC0", "tombstone": "Landscape Album in Various Styles: The Stream of Wuling, 1684. Zha Shibiao (Chinese, 1615\u20131698). Album leaf, ink and light color on paper; overall: 29.9 x 39.4 cm (11 3/4 x 15 1/2 in.). The Cleveland Museum of Art, Gift of Mr. and Mrs. Severance A. Millikin, 1955.37.4", "current_location": null, "title": "Landscape Album in Various Styles: The Stream of Wuling", "creation_date": "1684", "creation_date_earliest": 1684, "creation_date_latest": 1684, "artists_tags": ["male"], "culture": ["China, Qing dynasty (1644-1911)"], "technique": "album leaf, ink and light color on paper", "support_materials": [], "department": "Chinese Art", "collection": "ASIAN - Album leaf", "type": "Painting", "measurements": "Overall: 29.9 x 39.4 cm (11 3/4 x 15 1/2 in.)", "dimensions": {"overall": {"height": 0.299, "height_inch": 11, "height_inch_fraction": 0.75, "width": 0.394, "width_inch": 15, "width_inch_fraction": 0.5}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [{"inscription": "Artist's inscription, signature, and seal:\n\nThe stream of Wuling. Zha Shibiao [seal] Shibiao.", "inscription_translation": null, "inscription_remark": "Wuling is the mythic land described in Tao Qian's \"Record of the Peach-Blossom Spring.\"", "sortorder": null}], "exhibitions": {"current": [{"id": 521183, "title": "When Salt was Gold: Yangzhou, City of Riches and Art", "description": "<i>When Salt was Gold: Yangzhou, City of Riches and Art</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (May 12-November 5, 2023).", "opening_date": "2023-05-12T04:00:00"}], "legacy": [{"description": "<em>Chinese Landscape Painting</em>. The Cleveland Museum of Art, Cleveland, OH (organizer) (November 5-December 26, 1954).", "opening_date": "1954-11-05T00:00:00"}, {"description": "<em>The Colors of Ink</em>. The Cleveland Museum of Art, Cleveland, OH (April 9-May 12, 1974).", "opening_date": "1974-04-09T00:00:00"}, {"description": "<em>Conference on Oriental-Western Literary and Cultural Relations</em>. Indiana University, Bloomington, IN (1974).", "opening_date": "1974-01-01T00:00:00"}, {"description": "<em>Eight Dynasties of Chinese Painting</em>. The Nelson-Atkins Museum of Art (November 7, 1980-January 4, 1981); The Cleveland Museum of Art (February 10-March 29, 1981); Tokyo National Museum (October 4-November 17, 1982).", "opening_date": "1981-02-10T00:00:00"}]}, "provenance": [{"description": "Ma Yueguan \u99ac\u66f0\u742f [1688\u20131755]", "citations": [], "footnotes": null, "date": null, "sortorder": 1}, {"description": "Ding Huikang \u4e01\u60e0\u5eb7 [1868/1869\u2013about 1918] and Gu Anmi \u9867\u5b89\u5b93", "citations": [], "footnotes": null, "date": null, "sortorder": 2}, {"description": "(C. T. Loo & Co., New York, NY, sold to the Cleveland Museum of Art)", "citations": [], "footnotes": null, "date": "?-1955", "sortorder": 3}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": null, "date": "1955-", "sortorder": 4}], "find_spot": null, "related_works": [], "former_accession_numbers": ["55.37e"], "did_you_know": "Zha Shibiao, a native of Anhui province, moved to Yangzhou later in his career, like so many of his fellow countrymen.", "early_education_description": null, "artlens_description": null, "description": "At age 68, Zha Shibiao painted this album with seasonal landscapes in various styles. Painted in fresh colors and wet strokes, all depict typical scenes of Jiangnan. <br><br>The mention of Wuling in the inscription signals the \u201cPeach Blossom Spring,\u201d but Zha Shibiao purposefully left out all the accepted iconography for that story: a lone fisherman, cave entrance, and village of hermits. Instead, two men in separate boats are engaged in conversation. Could they be talking about the way to the Peach Blossom Spring, or could one of them be that fisherman blessed by his unintended visit but no longer able to find his way back again? Around them unfolds a lyrical landscape, with willows along the shores, an empty pavilion, a wide-open lake surface, and endless distant hills.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q60516839"], "internet_archive": ["https://archive.org/details/clevelandart-1955.37.4-landscape-album-in-v"]}, "citations": [{"citation": "Lee, Sherman E. <em>Chinese Landscape Painting</em>. Cleveland, OH: The Cleveland Museum of Art, 1954.", "page_number": "cat. no. 107", "url": null}, {"citation": "The Cleveland Museum of Art. <em>The Cleveland Museum of Art Handbook.</em> Cleveland, OH: The Cleveland Museum of Art, 1958.", "page_number": "Mentioned: cat. no. 875", "url": "https://archive.org/details/CMAHandbook1958/page/n155"}, {"citation": "Lee, Sherman Emery, and James Robinson. <em>The Colors of Ink: Chinese Paintings and Related Ceramics from the Cleveland Museum of Art</em>. New York: Asia Society; distributed by New York Graphic Society, 1974.", "page_number": null, "url": null}, {"citation": "Ho, Wai-kam, Sherman E. Lee, Laurence Sickman, and Marc F. Wilson. <em>Eight Dynasties of Chinese Painting: The Collections of the Nelson Gallery-Atkins Museum, Kansas City, and the Cleveland Museum of Art</em>. Cleveland, OH: Cleveland Museum of Art, in cooperation with Indiana University Press, 1980.", "page_number": "Reproduced: cat. no. 226, pp. 303-305", "url": null}, {"citation": "Chou, Ju-hsi and Anita Chung. <em>Silent poetry: Chinese paintings from the collection of the Cleveland Museum of Art</em>. Cleveland, OH: The Cleveland Museum of Art, 2015.", "page_number": "Mentioned and Reproduced: p. 386-390", "url": null}], "url": "https://clevelandart.org/art/1955.37.4", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/1955.37.4/1955.37.4_web.jpg", "width": "1133", "height": "893", "filesize": "782505", "filename": "1955.37.4_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1955.37.4/1955.37.4_print.jpg", "width": "3400", "height": "2679", "filesize": "7857097", "filename": "1955.37.4_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1955.37.4/1955.37.4_full.tif", "width": "5368", "height": "4230", "filesize": "68149912", "filename": "1955.37.4_full.tif"}}, "alternate_images": [], "creditline": "Gift of Mr. and Mrs. Severance A. Millikin", "image_credit": null, "sketchfab_id": null, "sketchfab_url": null, "gallery_donor_text": null, "athena_id": 132926, "creators": [{"id": 23580, "description": "Zha Shibiao (Chinese, 1615\u20131698)", "extent": null, "qualifier": null, "role": "artist", "biography": null, "name_in_original_language": "\u67e5\u58eb\u6a19", "birth_year": "1615", "death_year": "1698", "use_in_caption": true, "include_extent": false, "weight": 1}], "legal_status": "accessioned", "accession_date": "1955-03-10T00:00:00", "sortable_date": 1684, "date_added_to_oa": null, "date_text": "1684", "collapse_artists": false, "on_loan": false, "recently_acquired": false, "record_type": "component", "conservation_statement": null, "has_conservation_images": false, "cover_accession_number": "1955.37", "is_nazi_era_provenance": false, "impression": null, "alternate_titles": ["Landscape Album in Various Styles: the Stream of Wu-ling", "Album of Seasonal Landscapes \u56db\u5b63\u5c71\u6c34\u5716\u518a"], "is_highlight": false, "updated_at": "2026-05-29 06:50:24.911000"}]}