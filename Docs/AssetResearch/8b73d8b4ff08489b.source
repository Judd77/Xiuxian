e": "221486"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt22_print.jpg", "width": "3400", "height": "1840", "filesize": "1596386"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt22_full.tif", "width": "5616", "height": "3040", "filesize": "51259764"}, "date_created": "2021-02-26T13:23:57.073000", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt23_web.jpg", "width": "900", "height": "487", "filesize": "201777"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt23_print.jpg", "width": "3400", "height": "1840", "filesize": "1370166"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt23_full.tif", "width": "5616", "height": "3039", "filesize": "51242460"}, "date_created": "2021-02-26T13:25:03.058000", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt24_web.jpg", "width": "900", "height": "487", "filesize": "194033"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt24_print.jpg", "width": "3400", "height": "1840", "filesize": "1532321"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt24_full.tif", "width": "5616", "height": "3039", "filesize": "51241400"}, "date_created": "2021-02-26T13:26:03.048000", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt25_web.jpg", "width": "674", "height": "900", "filesize": "208408"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt25_print.jpg", "width": "2545", "height": "3400", "filesize": "3397198"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt25_full.tif", "width": "4992", "height": "6668", "filesize": "99885296"}, "date_created": "2010-05-20T13:44:38", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt26_web.jpg", "wid