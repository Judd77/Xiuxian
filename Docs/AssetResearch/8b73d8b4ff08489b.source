0_web.jpg", "width": "900", "height": "674", "filesize": "205346"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt30_print.jpg", "width": "3400", "height": "2545", "filesize": "2356290"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt30_full.tif", "width": "6668", "height": "4992", "filesize": "99888060"}, "date_created": "2010-05-19T19:39:43", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt31_web.jpg", "width": "900", "height": "674", "filesize": "196585"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt31_print.jpg", "width": "3400", "height": "2545", "filesize": "2088120"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt31_full.tif", "width": "6668", "height": "4992", "filesize": "99887540"}, "date_created": "2010-05-19T19:42:20", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt32_web.jpg", "width": "900", "height": "674", "filesize": "138555"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt32_print.jpg", "width": "3400", "height": "2545", "filesize": "1770285"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt32_full.tif", "width": "6668", "height": "4992", "filesize": "99885192"}, "date_created": "2010-05-19T19:44:54", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt33_web.jpg", "width": "900", "height": "312", "filesize": "105869"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt33_print.jpg", "width": "3400", "height": "1179", "filesize": "842771"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt33_full.tif", "width": "5000", "height": "1734", "filesize": "26033864"}, "date_created": "2004-04-14T12:18:43", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt34_web.jpg", "width": "900", "height": "312", "filesize": "94638"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt34_print.jpg", "width": "3400", "height": "1179", "filesize": "755215"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt34_full.tif", "width": "5000", "height": "1734", "filesize": "26033284"}, "date_created": "2004-04-14T12:13:40", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt35_web.jpg", "width": "900", "height": "315", "filesize": "113243"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt35_print.jpg", "width": "3400", "height": "1190", "filesize": "763369"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt35_full.tif", "width": "5000", "height": "1750", "filesize": "26273428"}, "date_created": "2004-04-14T12:06:28", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt36_web.jpg", "width": "900", "height": "312", "filesize": "57599"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt36_print.jpg", "width": "3400", "height": "1179", "filesize": "464395"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt36_full.tif", "width": "5000", "height": "1734", "filesize": "26031932"}, "date_created": "2004-04-14T11:55:42", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt37_web.jpg", "width": "900", "height": "103", "filesize": "50198"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt37_print.jpg", "width": "3400", "height": "390", "filesize": "389743"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1959.46/1959.46_alt37_full.tif", "width": "12000", "height": "1377", "filesize": "49593788"}, "date_created": "2004-04-13T17:26:20", "annotation": ""}], "creditline": "Purchase from the J. H. Wade Fund", "image_credit": null, "sketchfab_id": null, "sketchfab_url": null, "gallery_donor_text": null, "athena_id": 135964, "creators": [{"id": 22133, "description": "Dong Qichang (Chinese, 1555\u20131636)", "extent": null, "qualifier": null, "role": "artist", "biography": null, "name_in_original_language": "\u8463\u5176\u660c", "birth_year": "1555", "death_year": "1636", "use_in_caption": true, "include_extent": false, "weight": 1}], "legal_status": "accessioned", "accession_date": "1959-02-21T00:00:00", "sortable_date": 1624, "date_added_to_oa": null, "date_text": "c. 1624\u201327", "collapse_artists": false, "on_loan": false, "recently_acquired": false, "record_type": "object", "conservation_statement": null, "has_conservation_images": false, "cover_accession_number": null, "is_nazi_era_provenance": false, "impression": null, "alternate_titles": ["River and Mountains on a Clear Autumn Day \u6c5f\u5c71\u79cb\u973d\u5716"], "is_highlight": false, "updated_at": "2026-09-12 11:31:23.939000"}, {"id": 131673, "accession_number": "1954.263", "share_license_status": "CC0", "tombstone": "Conversation in Autumn (\u8b1b\u79cb\u5716), 1732. Hua Yan (Chinese, 1682\u2013c. 1765). Hanging scroll; ink and light color on paper; overall: 218.5 x 71.7 cm (86 x 28 1/4 in.). The Cleveland Museum of Art, John L. Severance Fund, 1954.263", "current_location": null, "title": "Conversation in Autumn", "title_in_original_language": "\u8b1b\u79cb\u5716", "creation_date": "1732", "creation_date_earliest": 1732, "creation_date_latest": 1732, "artists_tags": ["male"], "culture": ["China, Qing dynasty (1644\u20131911)"], "technique": "Hanging scroll; ink and light color on paper", "support_materials": [], "department": "Chinese Art", "collection": "ASIAN - Hanging scroll", "type": "Painting", "measurements": "Overall: 218.5 x 71.7 cm (86 x 28 1/4 in.)", "dimensions": {"painting only": {"height": 1.16, "height_inch": 45, "height_inch_fraction": 0.6875, "width": 0.4, "width_inch": 15, "width_inch_fraction": 0.75}, "overall": {"height": 2.185, "height_inch": 86, "height_inch_fraction": 0.0, "width": 0.717, "width_inch": 28, "width_inch_fraction": 0.25}, "overall with knobs": {"height": 2.185, "height_inch": 86, "height_inch_fraction": 0.0, "width": 0.803, "width_inch": 31, "width_inch_fraction": 0.625}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [{"inscription": "Artist's inscription, signature, and 2 seals: \n\nOn a winter day in the renzi year [1732], while leisurely sitting in my mountain pavilion, I happened to have imitated the brush style of Yuan masters on the two verses: \"A guest came from the dusty world for a visit; in the small cottage we talked about the sound of autumn.\"\n\nXin luo shan ren \u65b0\u7f85\u5c71\u4eba [seals] Hua Yan \u83ef\u55a6; Qiuyue \u79cb\u5cb3.", "inscription_translation": null, "inscription_remark": "\"The Sound of Autumn\" is the title of a famous rhymed prose by the great Song scholar, Ouyang Xiu (1007\u20131072).", "sortorder": 1}, {"inscription": "1 colophon and 2 seals of Zhang Tingji \u5f35\u5ef7\u6fdf (1768\u20131848): \n\nOld Hua [Yan], in this painting, was able to evoke the mood of desolation in nature and match the poetry elegantly.  If Fangweng [Lu You \u9678\u6e38 (1125\u20131210)] saw this, he would inscribe the painting with two words \"idyllic world \u8a69\u5883.\"", "inscription_translation": null, "inscription_remark": null, "sortorder": 2}, {"inscription": "\u65b0\u7f85\u5c71\u4eba\u70ba\u543e\u9109\u8001\u8f29\uff0c\u64c5\u9577\u5beb\u751f\u3002\u7f85\u81f4\u7fbd\u65cf\uff0c\u7feb\u5176\u98db\u9cf4\u98f2\u5544\u3002\u6545\u6240\u4f5c\u5225\u6709\u751f\u8da3\u3002\u5c71\u6c34\u4e0d\u591a\u3002\u4f5c\u5ba2\u51ac\u5728\u897f\u6ce0\uff0c\u898b\u6240\u767d\u96f2\u677e\u820e\u5716\u3002\u7a7a\u9748\u66e0\u9038\uff0c\u5f97\u672a\u66fe\u6709\uff0c\u81f3\u4eca\u61b6\u4e4b\u3002\u5179\u5e45\u4ee5\u84bc\u79c0\u52dd\uff0c\u8352\u5bd2\u4e4b\u4e2d\uff0c\u5fa9\u9952\u9038\u8da3\u3002\u5982\u5750\u6211\u9d60\u7063\u3001\u9f8d\u7003\u9593\u77e3\u3002", "inscription_translation": "1 colophon, dated 1825, and 2 seals of Chen Wenshu \u9673\u6587\u8ff0 (1771\u20131842):  \n\nXinluo the Mountain Man was of an older generation in my native place. He is skilled in drawing from life, having encompassed all the feathered creatures and studied their [habits] in flight, calling, drinking and pecking. Consequently, his paintings in this genre are noted for lively exuberance. His landscapes are rarer. When I was a winter visitor in Xileng, I chanced to see his White Clouds over Pine Lodge. In its emptiness, its spiritual essence, its vastness and its untrammeled flavor, it is without peer. Even today, I could remember it distinctly. The painting here is known for its aged elegance. In the chilling wilderness, it is fraught with an untrammeled spirit. [With these two paintings,] it is as if I were sitting between the Snowgoose Bay and the Dragon Pool. \n\nMy good nephew P'iao-sheng obtained the painting from Yufeng and showed it to me.  So I write a few lines here to commemorate this \"ink-relationship.\" In the yiyou year of Daoguang [1825], at the end of the autumn, the lay-Buddhist Yi dao ju shi, Wenshu wrote this at the cottage of Xiang shan hua yin (Meditation in Fragrance and Reclusion among Flowers).", "inscription_remark": "The catalogue Silent Poetry only gives a transcription of the first part of the inscription.", "sortorder": 3}, {"inscription": "1 colophon and 1 seal of Zhu Angzhi \u6731\u6602\u4e4b (1764\u20131841): \n \nThe highest achievement in the art of painting is to penetrate deeply into the chamber of old masters, but at the same time transcend the bounds of conventional rules. This painting of Xinluo is derived from [the style of] Baishi (Shen Zhou \u6c88\u5468, 1427\u20131509) and Baoshan (Lu Zhi \u9678\u6cbb, 1496\u20131576) with splashed-ink technique of Wang Qia \u738b\u6d3d (Wang Mo \u738b\u9ed8, ?\u2013805), in addition to his own innovative ideas. Hence the distinctive style. Truly, he is one of those who passed through the net of the Six Canons [of Xie He \u8b1d\u8d6b, 479\u2013502]; treasure it.", "inscription_translation": null, "inscription_remark": null, "sortorder": 4}, {"inscription": "2 seals of Ye Tingguan \u8449\u5ef7\u742f (b. 1791); \n\n1 seal unidentified.", "inscription_translation": null, "inscription_remark": null, "sortorder": 5}], "exhibitions": {"current": [{"id": 300427, "title": "Chinese Landscape Painting", "description": "<i>Chinese Landscape Painting</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (November 5-December 26, 1954).", "opening_date": "1954-11-05T04:00:00"}, {"id": 520238, "title": "Master of Landscape: East and West", "description": "<i>Master of Landscape: East and West</i>. Munson Museum of Art, Utica, NY (organizer) (September 15-October 13, 1963); Memorial Art Gallery of the University of Rochester, Rochester, NY (November 1-December 1, 1963).", "opening_date": "1963-09-15T04:00:00"}, {"id": 516263, "title": "Fantastics and Eccentrics in Chinese Painting", "description": "<i>Fantastics and Eccentrics in Chinese Painting</i>. The Asia Society Museum, New York, NY (organizer) (March 23-May 28, 1967); Los Angeles County Museum of Art, Los Angeles, CA (June 20-August 13, 1967); Fine Arts Museums of San Francisco, de Young Museum, San Francisco, CA (September 15-November 5, 1967).", "opening_date": "1967-03-24T05:00:00"}, {"id": 304517, "title": "Eight Dynasties of Chinese Painting", "description": "<i>Eight Dynasties of Chinese Painting</i>. The Nelson-Atkins Museum of Art (November 7, 1980-January 4, 1981); The Cleveland Museum of Art (February 11-March 29, 1981); Tokyo National Museum (October 4-November 17, 1982); The Asia Society Museum, New York, NY (December 3, 1982-February 28, 1983).", "opening_date": "1981-02-11T05:00:00"}, {"id": 310041, "title": "Mountains, Rocks, and Water: Landscape Painting in Asia", "description": "<i>Mountains, Rocks, and Water: Landscape Painting in Asia</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (October 2-December 13, 1987).", "opening_date": "1987-10-02T04:00:00"}, {"id": 203084, "title": "Ji Yun-Fei: Last Days of Village Wen", "description": "<i>Ji Yun-Fei: Last Days of Village Wen</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (February 12-July 31, 2016).", "opening_date": "2016-02-12T00:00:00"}], "legacy": [{"description": "<em>Main Asian Rotation (Gallery 119)</em>. The Cleveland Museum of Art, Cleveland, OH (October 29, 2003-March 15, 2004).", "opening_date": "2003-10-29T00:00:00"}]}, "provenance": [{"description": "Ye Tingguan \u8449\u5ef7\u742f [b. 1791]", "citations": [], "footnotes": [], "date": null, "sortorder": 1}, {"description": "Sun Zutong \u5b6b\u7956\u540c [1894\u20131937]", "citations": [], "footnotes": [], "date": null, "sortorder": 2}, {"description": "Yu Zituo \u865e\u5b50\u579e [early 20th century]", "citations": [], "footnotes": [], "date": null, "sortorder": 3}, {"description": "(Walter Hochstadter [1914\u20132007], New York, NY, sold to the Cleveland Museum of Art)", "citations": [], "footnotes": [], "date": "?\u20131954", "sortorder": 4}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": [], "date": "1954\u2013", "sortorder": 5}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "A barren tree on the lower left has a hole in its lower trunk through which is visible a young servant carrying food to the gentlemen in the cottage.", "early_education_description": null, "artlens_description": null, "description": "Two figures sit conversing in a thatched cottage. This painting illustrates two poetic lines:<br><br>My guest came to sit beyond the dust, <br>In a narrow room, we talked about the autumnal sounds of autumn. <br><br>Hua Yan presented an intimate world\u2014simple and rustic\u2014amid a landscape. The cool wilderness depicted in this work conveys an aloofness that may reveal the inner world of a scholar-artist who failed the civil service examination but preserved a sense of pride and endurance in his humble surroundings.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q60516462"], "internet_archive": ["https://archive.org/details/clevelandart-1954.263-conversation-in-autu"]}, "citations": [{"citation": "Deng, Qiumei \u9127\u79cb\u679a. <em>Shen zhou da guan </em>\u795e\u5dde\u5927\u89c0. Shanghai: Shen zhou guo guang she, 1912.", "page_number": "Reproduced: pl. (18)", "url": null}, {"citation": "Kawai, Senro \u6cb3\u4e95\u8343\u5eec, editor. <em>Shina nanga taisei </em>\u652f\u90a3\u5357\u756b\u5927\u6210. To\u0304kyo\u0304: Ko\u0304bunsha, 1935.", "page_number": "Mentioned and Reproduced: X, pl. 137", "url": null}, {"citation": "Pan, Zunqi \u6f58\u9075\u7948. <em>Xu jing zhai suo cang ming hua ji </em>\u865b\u975c\u9f4b\u6240\u85cf\u540d\u756b\u96c6. Shanghai: Shang wu yin shu guan, Minguo 24 [1935].", "page_number": "Reproduced: pl. 12", "url": null}, {"citation": "Sire\u0301n, Osvald. <em>A History of Later Chinese Painting</em>. London: The Medici Society, 1938.", "page_number": "Mentioned: II, Lists, 253", "url": null}, {"citation": "O\u0304mura, Seigai \u5927\u6751\u897f\u5d16 and O\u0304mura Kido\u0304 \u5927\u6751\u6587\u592b. <em>Chu\u0304goku meigashu\u0304. 8</em> [\u4e2d\u56fd\u540d\u753b\u96c6. \u7b2c8\u518a = Collection of famous Chinese paintings]. To\u0304kyo\u0304: Ryu\u0304bunshokyoku, 1945.", "page_number": "VIII, pl. 13", "url": null}, {"citation": "Lee, Sherman E. <em>Chinese Landscape Painting</em>. Cleveland, OH: The Cleveland Museum of Art, 1954.", "page_number": "Mentioned: p. 157, cat. no. 110; Reproduced: p. 134", "url": "https://archive.org/details/ChineseLandscape"}, {"citation": "Sire\u0301n, Osvald. <em>Chinese Painting: Leading Masters and Principles</em>. New York: Ronald Press, 1956.", "page_number": "Mentioned: VII, Lists, 343", "url": null}, {"citation": "The Cleveland Museum of Art. <em>The Cleveland Museum of Art Handbook.</em> Cleveland, OH: The Cleveland Museum of Art, 1958.", "page_number": "Mentioned and Reproduced: cat. no. 880", "url": "https://archive.org/details/CMAHandbook1958/page/n156"}, {"citation": "Lee, Sherman E. <em>Chinese Landscape Painting</em>. Cleveland, OH: The Cleveland Museum of Art, 1962.", "page_number": "Mentioned: p. 126, no. 101", "url": null}, {"citation": "<em>Masters of Landscape: East and West</em>. Utica, NY: Munson-Williams-Proctor Institute, 1963.", "page_number": "Mentioned: cat. no. 16", "url": null}, {"citation": "Lee, Sherman E. <em>A History of Far Eastern Art</em>. New York: H.N. Abrams, 1964.", "page_number": "Mentioned and Reproduced: p. 455, fig. 601", "url": null}, {"citation": "The Cleveland Museum of Art. <em>Handbook of the Cleveland Museum of Art/1966</em>. Cleveland, OH: The Cleveland Museum of Art, 1966.", "page_number": "Reproduced: p. 269", "url": "https://archive.org/details/CMAHandbook1966/page/n293"}, {"citation": "Cahill, James, and Virginia Field.<em> Fantastics and Eccentrics in Chinese Painting</em>. [New York]: Asia Society; distributed by Abrams, 1967.", "page_number": "cat. no. 33", "url": null}, {"citation": "The Cleveland Museum of Art. <em>Handbook of the Cleveland Museum of Art/1969</em>. Cleveland, OH: The Cleveland Museum of Art, 1969.", "page_number": "Reproduced: p. 269", "url": "https://archive.org/details/CMAHandbook1969/page/n293"}, {"citation": "Cahill, James. \"Ch\u016bgoku kaiga niokeru kis\u014d to gens\u014d\" [Fantastics and eccentrics in Chinese painting] (part II). <em>Kokka</em> (1975): no. 979, pp. 2\u201321.", "page_number": null, "url": null}, {"citation": "The Cleveland Museum of Art. <em>Handbook of the Cleveland Museum of Art/1978</em>. Cleveland, OH: The Cleveland Museum of Art, 1978.", "page_number": "Reproduced: p. 358", "url": "https://archive.org/details/CMAHandbook1978/page/n378"}, {"citation": "Ho, Wai-kam, Sherman E. Lee, Laurence Sickman, and Marc F. Wilson. <em>Eight Dynasties of Chinese Painting: The Collections of the Nelson Gallery-Atkins Museum, Kansas City, and the Cleveland Museum of Art</em>. Cleveland, OH: Cleveland Museum of Art, in cooperation with Indiana University Press, 1980.", "page_number": "Mentioned and Reproduced: cat. no. 265, p. 361", "url": null}, {"citation": "Barnhart, Richard M. <em>The Jade studio: masterpieces of Ming and Qing painting and calligraphy from the Wong Nan-p\u02bbing collection</em>. New Haven, CT: Yale University Art Gallery, 1994.", "page_number": "Mentioned and Reproduced: fig. 61, p. 195", "url": null}, {"citation": "Honour, Hugh, and John Fleming. <em>A World History of Art, 5th Edition</em>. London: Laurence King, 1999.", "page_number": "Mentioned and Reproduced: no. 16.5, p. 696", "url": null}, {"citation": "Honour, Hugh, and John Fleming. <em>A World History of Art, 7th Edition. </em>London: Laurence King, 2005.", "page_number": "Mentioned and Reproduced: p. 690, fig. 16.5", "url": null}, {"citation": "Chou, Ju-hsi and Anita Chung. <em>Silent poetry: Chinese paintings from the collection of the Cleveland Museum of Art</em>. Cleveland, OH: The Cleveland Museum of Art, 2015.", "page_number": "Mentioned and Reproduced: pp. 440\u2013446", "url": null}], "url": "https://clevelandart.org/art/1954.263", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/1954.263/1954.263_web.jpg", "width": "363", "height": "893", "filesize": "224340", "filename": "1954.263_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1954.263/1954.263_print.jpg", "width": "1381", "height": "3400", "filesize": "3300314", "filename": "1954.263_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1954.263/1954.263_full.tif", "width": "2574", "height": "6337", "filesize": "48961120", "filename": "1954.263_full.tif"}}, "alternate_images": [{"web": {"url": "https://openac