eb": {"url": "https://openaccess-cdn.clevelandart.org/1954.263/1954.263_alt4_web.jpg", "width": "388", "height": "893", "filesize": "245515"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1954.263/1954.263_alt4_print.jpg", "width": "1476", "height": "3400", "filesize": "2934436"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1954.263/1954.263_alt4_full.tif", "width": "2170", "height": "5000", "filesize": "32563516"}, "annotation": ""}], "creditline": "John L. Severance Fund", "image_credit": null, "sketchfab_id": null, "sketchfab_url": null, "gallery_donor_text": null, "athena_id": 131673, "creators": [{"id": 23570, "description": "Hua Yan (Chinese, 1682\u2013c. 1765)", "extent": null, "qualifier": null, "role": "artist", "biography": null, "name_in_original_language": "\u83ef\u55a6", "birth_year": "1682", "death_year": "1756", "use_in_caption": true, "include_extent": false, "weight": 1}], "legal_status": "accessioned", "accession_date": "1954-05-04T00:00:00", "sortable_date": 1732, "date_added_to_oa": null, "date_text": "1732", "collapse_artists": false, "on_loan": false, "recently_acquired": false, "record_type": "object", "conservation_statement": null, "has_conservation_images": false, "cover_accession_number": null, "is_nazi_era_provenance": false, "impression": null, "alternate_titles": ["Conversation in Autumn \u8b1b\u79cb\u5716"], "is_highlight": false, "updated_at": "2026-08-15 11:17:58.216000"}]}