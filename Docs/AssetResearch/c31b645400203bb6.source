nnotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1976.1/1976.1_alt13_web.jpg", "width": "1263", "height": "689", "filesize": "636030"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1976.1/1976.1_alt13_print.jpg", "width": "3400", "height": "1856", "filesize": "5383690"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1976.1/1976.1_alt13_full.tif", "width": "6610", "height": "3608", "filesize": "71575788"}, "date_created": "2007-07-19T18:57:40", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1976.1/1976.1_alt14_web.jpg", "width": "1263", "height": "689", "filesize": "634221"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1976.1/1976.1_alt14_print.jpg", "width": "3400", "height": "1854", "filesize": "5361952"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1976.1/1976.1_alt14_full.tif", "width": "6646", "height": "3624", "filesize": "72284404"}, "date_created": "2007-07-19T19:02:38", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1976.1/1976.1_alt15_web.jpg", "width": "1263", "height": "697", "filesize": "620601"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1976.1/1976.1_alt15_print.jpg", "width": "3400", "height": "1877", "filesize": "5353652"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1976.1/1976.1_alt15_full.tif", "width": "6651", "height": "3672", "filesize": "73296360"}, "date_created": "2007-07-19T19:06:24", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1976.1/1976.1_alt16_web.jpg", "width": "1263", "height": "695", "filesize": "653949"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1976.1/1976.1_alt16_print.jpg", "width": "3400", "height": "1870", "filesize": "5220696"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1976.1/1976.1_alt16_full.tif", "width": "6634", "height": "3648", "filesize": "72632780"}, "date_created": "2007-07-19T19:13:27", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/1976.1/1976.1_alt17_web.jpg", "width": "1263", "height": "694", "filesize": "778535"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1976.1/1976.1_alt17_print.jpg", "width": "3400", "height": "1869", "filesize": "4928063"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1976.1/1976.1_alt17_full.tif", "width": "6668", "height": "3666", "filesize": "73369532"}, "date_created": "2007-07-19T19:16:18", "annotation": ""}], "creditline": "John L. Severance Fund", "image_credit": null, "sketchfab_id": null, "sketchfab_url": null, "gallery_donor_text": null, "athena_id": 148395, "creators": [{"id": 30162, "description": "Zhou Wenju (Chinese, active 942\u2013961)", "extent": null, "qualifier": "after a work attributed to", "role": "artist", "biography": null, "name_in_original_language": "\u5468\u6587\u77e9", "use_in_caption": true, "include_extent": false, "weight": 2}], "legal_status": "accessioned", "accession_date": "1976-01-08T00:00:00", "sortable_date": 1127, "date_added_to_oa": null, "date_text": "before 1140", "collapse_artists": false, "on_loan": false, "recently_acquired": false, "record_type": "object", "conservation_statement": null, "has_conservation_images": false, "cover_accession_number": null, "is_nazi_era_provenance": false, "impression": null, "alternate_titles": ["In the Palace"], "is_highlight": false, "updated_at": "2026-07-28 15:33:40.509000"}, {"id": 149604, "accession_number": "1979.27.1", "share_license_status": "CC0", "tombstone": "Paintings after Ancient Masters: Volume 1 (\u8001\u84ee\u6a45\u53e4), 1598\u20131652. Chen Hongshou (Chinese, 1598/99\u20131652). Album with eleven leaves; ink or ink and color on silk; overall: 30.2 x 26.7 cm (11 7/8 x 10 1/2 in.); overall: 30.2 x 53.4 cm (11 7/8 x 21 in.). The Cleveland Museum of Art, John L. Severance Fund, 1979.27.1", "current_location": null, "title": "Paintings after Ancient Masters: Volume 1", "title_in_original_language": "\u8001\u84ee\u6a45\u53e4", "creation_date": "1598\u20131652", "creation_date_earliest": 1598, "creation_date_latest": 1652, "artists_tags": ["male"], "culture": ["China, Ming dynasty (1368\u20131644)"], "technique": "Album with eleven leaves; ink or ink and color on silk", "support_materials": [], "department": "Chinese Art", "collection": "ASIAN - Album leaf", "type": "Painting", "measurements": "Overall: 30.2 x 26.7 cm (11 7/8 x 10 1/2 in.); Overall: 30.2 x 53.4 cm (11 7/8 x 21 in.)", "dimensions": {"sheet": {"height": 0.242, "height_inch": 9, "height_inch_fraction": 0.5, "width": 0.237, "width_inch": 9, "width_inch_fraction": 0.3125}, "overall": {"height": 0.302, "height_inch": 11, "height_inch_fraction": 0.875, "width": 0.534, "width_inch": 21, "width_inch_fraction": 0.0}, "cover": {"height": 0.305, "height_inch": 12, "height_inch_fraction": 0.0, "width": 0.267, "width_inch": 10, "width_inch_fraction": 0.5}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [{"inscription": "Artist's titles, signatures, and 21 seals:\n\nA. Scholars in a Garden.  Hongshou painted for old Chung. [seal] Chang-hou.\nB. Laozi Riding an Ox.  Hongshou respectfully painted. [seal] Ch'en yin Hongshou.\nC. Narcissus and Bare Trees. The Taoist Chung-ch'ing entrusted Lao-lien to paint [this]. [seal] Chang-hou.\nD. Autumn Landscape. Lao-lien painted this for Lao-ts'ang. [seal] Chang-hou.\nE. Portrait of Tao Yuanming. Lao-lien [seal] Hongshou.\nF. Lotus and Rocks. Hung-shou painted after the style of Ts'ui Po and presented it to the Buddhist disciple Lin Chung-ch'ing. [seal] Chang-hou.\nG. Daoist and Crane in Autumn Landscape. The old man Fu-ch'ih painted for the Daoist Chung-ch'ing. [seal] Chang-hou.\nH. Portrait of Chung-ch'ing in a Landscape. Lao-lien painted for Chung-ch'ing. [2 seals] Chang-hou; Ch'en yin Hung-shou.\nI. Chrysanthemum and Rock. Hongshou [seal] Hongshou.\nJ. Landscape in the Style of Ni Zan. Lao-lien [seal] Chang-hou.\nL. Mr. Five Willows (Wu-liu), Tao Yuanming. Mr. Five Willows Chung-ch'ing entrusted Hongshou to paint [this]. [seal] Chang-hou.\nM. A Lohan [after Kuan-hsui]. Buddhist disciple Chen Hongshou respectfully painted. [2 seals] Chun-t'i ti-tzu; Chang-hou.\nN. A Bird and Peach-Blossom Branch. Hui-lun-shang painted after Tao-chun [Emperor Huizong] and presented it to Ts'ang-fu chu-chih. [seal] Chen yin Hongshou.\nO. Travellers in an Autumn Landscape. Hongshou  [seal] Chang-hou.\nP. A Lady. Hongshou [seal] Hongshou .\nQ. Chrysanthemum. Hongshou  painted in imitation of the Northern Song style for Daoist friend, Ts'ang-fu. [seal] Chang-hou.\nR. Scholar Reading in a Thatched Hut by a Waterfall. Chung-ch'ing entrusted Hongshou to paint. [seal] Chang-hou.\nS. Scholar with Staff and Brush. Hongshou [seal] Chang-hou.\nT. An Ancient Tree. Hongshou  [seal] Chang-hou.\nU. Rock, Old Tree, and Bamboo. Hongshou  [seal] Hongshou.", "inscription_translation": null, "inscription_remark": null, "sortorder": null}, {"inscription": "2 colophons (leaves K and V) and 34 additional seals:  24 seals of Lin Chung-ch'ing (Lin Ts'ang-fu or Lin T'ing-tung, friend of Chen Hongshou, for whom the album was painted); 2 colophons, dated 1893 and 1899, and 5 seals of Weng Tonghe \u7fc1\u540c\u9fa2 (1830-1904); 2 seals of Weng Tongjue \u7fc1\u540c\u7235 (older brother of Weng Tonghe; 1814-1877); 2 seals of Weng Wan-go \u7fc1\u842c\u6208 (1918-2020); 1 unidentified.", "inscription_translation": null, "inscription_remark": null, "sortorder": null}], "exhibitions": {"current": [{"id": 304517, "title": "Eight Dynasties of Chinese Painting", "description": "<i>Eight Dynasties of Chinese Painting</i>. The Nelson-Atkins Museum of Art (November 7, 1980-January 4, 1981); The Cleveland Museum of Art (February 11-March 29, 1981); Tokyo National Museum (October 4-November 17, 1982); The Asia Society Museum, New York, NY (December 3, 1982-February 28, 1983).", "opening_date": "1981-02-11T05:00:00"}, {"id": 211775, "title": "Highlights of Asian Paintings from The Cleveland Museum of Art", "description": "<i>Highlights of Asian Paintings from The Cleveland Museum of Art</i>. Nara National Museum (organizer) (February 21-March 29, 1998); Suntory Museum of Art (April 28-June 21, 1998).", "opening_date": "1998-02-21T00:00:00"}], "legacy": [{"description": "<em>Five centuries of Chinese painting: Ming &amp; Ch'ing dynasties. </em>Dallas Museum of Fine Arts, Dallas, TX (June 27\u2013August 8, 1954).", "opening_date": "1954-08-08T00:00:00"}, {"description": "<em>1000 Jahre Chinesische Malerei</em>. Haus der Kunst, Munich, Germany (October 16-December 13, 1959).", "opening_date": "1959-10-16T00:00:00"}, {"description": "<em>Chinese Art: An Exhibition of Paintings, Jades, Bronzes and Ceramics: Being a Contribution Made by Smith College Museum of Art to the College Interim Session, 1962</em>. Northampton, MA (1962). (leaves A-J)", "opening_date": "1962-01-01T00:00:00"}, {"description": "<em>Fantastics and Eccentrics</em>. Asia House Gallery, New York, NY, (March 23-May 28, 1967); Los Angeles County Museum of Art, CA (June 20-August 13, 1967); and M. H. De Young Memorial Museum, San Francisco, CA (September 15-November 5, 1967).", "opening_date": "1967-03-23T00:00:00"}]}, "provenance": [{"description": "Weng Tonghe \u7fc1\u540c\u9fa2 [1830\u20131904], by descent to  Wango H. C. Weng", "citations": [], "footnotes": [], "date": null, "sortorder": 1}, {"description": "(Wango H. C. Weng \u7fc1\u842c\u6208 [1918\u20132020], Lyme, NH, sold to the Cleveland Museum of Art)", "citations": [], "footnotes": [], "date": "?\u20131979", "sortorder": 2}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": [], "date": "1979\u2013", "sortorder": 3}], "find_spot": null, "related_works": [], "former_accession_numbers": ["79.27,a-j"], "did_you_know": "This album was owned by Weng Tonghe, who was tutor to the Tongzhi Emperor (r. 1862\u201375) and the Guangxu Emperor (r. 1875\u20131908).", "early_education_description": null, "artlens_description": null, "description": "The twenty paintings in this double album by Chen Hongshou include landscapes, figures, and flowers. It also has one leaf featuring a woman, an often-used subject not found in the other albums from the latter part of his career. His late works are wonderful summations of Chen's peculiar and quirky art\u2014archaistic, hyper-refined\u2014but without accompanying shallowness or sentimentality.<br><br>His figures and landscapes in the late albums are miniaturized, not unlike the small Chinese gardens, or the carefully selected small table rocks or old roots used for contemplation to see the world in miniature. This loss of scale is quite deliberate and reflects the psychological situation of a depressed class like the Ming loyalist officials and scholars, deprived of their integrity and honor, and forced to lead a diminished and restricted existence.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q60473786"], "internet_archive": ["https://archive.org/details/clevelandart-1979.27.1-paintings-after-anci"]}, "citations": [{"citation": "<em>Five Centuries of Chinese Painting: Ming &amp; Ch'ing Dynasties : [Exhibition] June 27 Through August 8, 1954, Dallas Museum of Fine Arts</em>. Dallas: Dallas Museum of Fine Arts, 1954.", "page_number": "cat. no. 24", "url": ""}, {"citation": "Goepper, Roger. <em>1000 Jahre chinesische Malerei</em>. Mu\u0308nchen: Haus der Kunst, 1959.", "page_number": "cat. no. 81", "url": ""}, {"citation": "<em>Chinese Art: An Exhibition of Paintings, Jades, Bronzes and Ceramics</em>. Northampton, MA: Smith College Museum of Art, 1962.", "page_number": "cat. no. 25", "url": ""}, {"citation": "Cahill, James, and Virginia Field. <em>Fantastics and Eccentrics in Chinese Painting</em>. [New York]: Asia Society; distributed by Abrams, 1967.", "page_number": "pp. 38, 39, cat. no. 10", "url": ""}, {"citation": "Ho, Wai-kam, Sherman E. Lee, Laurence Sickman, and Marc F. Wilson. <em>Eight Dynasties of Chinese Painting: The Collections of the Nelson Gallery-Atkins Museum, Kansas City, and the Cleveland Museum of Art.</em> Cleveland, OH: Cleveland Museum of Art, in cooperation with Indiana University Press, 1980.", "page_number": "Mentioned and Reproduced: cat. no. 207, pp. 268\u2013272", "url": ""}, {"citation": "<em>T\u014dy\u014d kaiga no seika: tokubetsuten: Kur\u012bvurando Bijutsukan no korekushon kara </em>[\u6771\u6d0b\u7d75\u753b\u306e\u7cbe\u83ef: \u7279\u522b\u5c55: \u30af\u30ea\u30fc\u30f4\u30e9\u30f3\u30c8\u7f8e\u8853\u9928\u306e\u30b3\u30ec\u30af\u30b7\u30e7\u30f3\u304b\u3089= Highlights of Asian painting from the Cleveland Museum of Art]. Nara, Japan: Nara National Museum, 1998.", "page_number": "Mentioned and Reproduced: pp. 68\u201369, cat. no. 42", "url": ""}], "url": "https://clevelandart.org/art/1979.27.1", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/1979.27.1/1979.27.1_web.jpg", "width": "753", "height": "893", "filesize": "514185", "filename": "1979.27.1_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1979.27.1/1979.27.1_print.jpg", "width": "2867", "height": "3400", "filesize": "7575223", "filename": "1979.27.1_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1979.27.1/1979.27.1_full.tif", "width": "3870", "height": "4588", "filesize": "53294848", "filename": "1979.27.1_full.tif"}}, "alternate_images": [], "creditline": "John L. Severance Fund", "image_credit": null, "sketchfab_id": null, "sketchfab_url": null, "gallery_donor_text": null, "athena_id": 149604, "creators": [{"id": 6274, "description": "Chen Hongshou (Chinese, 1598/99\u20131652)", "extent": null, "qualifier": null, "role": "artist", "biography": null, "name_in_original_language": "\u9673\u6d2a\u7dac", "birth_year": "1598", "death_year": "1652", "use_in_caption": true, "include_extent": false, "weight": 1}], "legal_status": "accessioned", "accession_date": "1979-06-21T00:00:00", "sortable_date": 1598, "date_added_to_oa": null, "date_text": "1598\u20131652", "collapse_artists": false, "on_loan": false, "recently_acquired": false, "record_type": "component", "conservation_statement": null, "has_conservation_images": false, "cover_accession_number": "1979.27", "is_nazi_era_provenance": false, "impression": null, "alternate_titles": [], "is_highlight": false, "updated_at": "2026-05-29 07:42:18.761000"}]}